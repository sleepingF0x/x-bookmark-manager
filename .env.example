# Docker / Node edition. Copy to .env and fill in.

# Only for docker-compose.yml: the domain Caddy gets an HTTPS certificate for (DNS must point here).
DOMAIN=

# Site password (any username works). Required: without it every request is refused.
SITE_PASSWORD=
# Optional, only when this server sits behind Cloudflare Tunnel + Access: verify Access tokens
# instead of the password. Set both or neither.
# ACCESS_TEAM_DOMAIN=https://<team>.cloudflareaccess.com
# ACCESS_AUD=

# X developer app, OAuth 2.0 (console.x.com → your app → Keys and tokens).
X_CLIENT_ID=
X_CLIENT_SECRET=

# Cloudflare Workers AI for search embeddings (@cf/baai/bge-m3, free daily allowance).
# API token needs the "Workers AI: Read" permission (dash.cloudflare.com → My Profile → API Tokens).
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# The model endpoint and the monthly X API caps are set on the site's 设置 panel. LLM_BASE_URL,
# LLM_API_KEY, LLM_MODEL, LLM_FORMAT, X_MONTHLY_READ_CAP and X_MONTHLY_WRITE_CAP from older setups
# still work as the values used while the panel has none.

# Optional: the public address the X OAuth callback goes to (<PUBLIC_URL>/api/x/callback). Normally
# worked out from the request: Caddy forwards Host and X-Forwarded-Proto, and on your own computer it
# is the address you open (use http://127.0.0.1:8787, which X accepts over http, not localhost).
# PUBLIC_URL=https://<DOMAIN>
