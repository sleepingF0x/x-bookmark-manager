# Docker / Node edition. Copy to .env and fill in.

# Public address of this site, used for the X OAuth callback (<PUBLIC_URL>/api/x/callback).
#   On a server with docker-compose + Caddy: https://<DOMAIN>
#   On your own computer: http://127.0.0.1:8787 (X accepts 127.0.0.1 callbacks over http)
PUBLIC_URL=http://127.0.0.1:8787
# Only for docker-compose.yml: the domain Caddy gets an HTTPS certificate for (DNS must point here).
DOMAIN=

# Site password (any username works). Required: without it every request is refused.
SITE_PASSWORD=

# X developer app, OAuth 2.0 (console.x.com → your app → Keys and tokens).
X_CLIENT_ID=
X_CLIENT_SECRET=

# Your LLM for labelling and cleanup analysis (OpenAI- or Anthropic-compatible).
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
# LLM_FORMAT=openai

# Cloudflare Workers AI for search embeddings (@cf/baai/bge-m3, free daily allowance).
# API token needs the "Workers AI: Read" permission (dash.cloudflare.com → My Profile → API Tokens).
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Optional monthly X API caps (counted reads / writes).
# X_MONTHLY_READ_CAP=1500
# X_MONTHLY_WRITE_CAP=200
