# Secrets for the Cloudflare edition. The Deploy to Cloudflare button asks for these;
# for `npm run dev`, copy this file to .dev.vars and fill it in.
SITE_PASSWORD=
X_CLIENT_ID=
X_CLIENT_SECRET=
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# Optional: sign in with Cloudflare Access instead of SITE_PASSWORD (see README).
# Usually set in the dashboard after enabling Access, not here; wrangler dev has no Access in front.
# ACCESS_TEAM_DOMAIN=https://<team>.cloudflareaccess.com
# ACCESS_AUD=
